# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
# Local: mongodb://127.0.0.1:27017/zero-to-shipped
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/zero-to-shipped?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/zero-to-shipped

# Comma-separated list of allowed origins for CORS (the Vite dev server)
CORS_ORIGIN=http://localhost:5173
