# Frontend environment variables.
# Copy to `.env.local` for local overrides. On Vercel, set these in the
# project's Environment Variables instead.

# Base URL of the backend API.
# - Leave UNSET for local dev: Vite proxies "/api" to http://localhost:5000.
# - On Vercel (separate frontend + backend projects) set it to your deployed
#   backend URL, INCLUDING the /api suffix, e.g.:
#   VITE_API_BASE=https://your-backend.vercel.app/api
# VITE_API_BASE=/api
